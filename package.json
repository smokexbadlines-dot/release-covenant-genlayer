{
  "name": "release-covenant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "verify:fixture": "node deploy/verify-fixture.mjs",
    "verify:probe": "node deploy/verify-probe.mjs",
    "verify:proof": "node deploy/verify-proof.mjs",
    "verify:repair": "node deploy/verify-proof.mjs ./repair-proof.json",
    "verify:refund": "node deploy/verify-proof.mjs ./refund-proof.json",
    "verify:late-credit": "node deploy/verify-proof.mjs ./late-credit-proof.json",
    "verify:negative": "node deploy/verify-proof.mjs ./negative-proof.json",
    "verify:wallet": "node deploy/verify-proof.mjs ./wallet-proof.json"
  },
  "dependencies": {
    "genlayer-js": "^1.1.8",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
